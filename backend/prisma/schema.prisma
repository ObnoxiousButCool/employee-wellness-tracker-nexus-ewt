// Prisma schema for Employee Wellness Tracker Nexus (EWT)
// Story S2: normalized roles/departments foundation + wellness entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model Department {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")
  users    User[]

  @@map("departments")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  roleId         Int             @map("role_id")
  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  departmentId   Int?            @map("department_id")
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  wellnessEntries WellnessEntry[]

  // S7 perf audit: covers GET /api/dashboard/summary's and
  // GET /api/wellness/history's department+status scoping (in place since
  // S2 fix iteration 3) so both stay index-backed as the table grows.
  @@index([departmentId, isActive])
  @@map("users")
}

enum Mood {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  GREAT
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model WellnessEntry {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  entryDate   DateTime    @map("entry_date") @db.Date
  stressLevel Int         @map("stress_level")
  workHours   Decimal     @map("work_hours") @db.Decimal(4, 2)
  sleepHours  Decimal     @map("sleep_hours") @db.Decimal(4, 2)
  mood        Mood
  energyLevel EnergyLevel @map("energy_level")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // S7 perf audit: this unique constraint (in place since S3) is itself a
  // composite index on (user_id, entry_date), covering the exact lookup
  // GET /api/dashboard/summary and GET /api/wellness/history issue
  // (userId IN (...) AND entryDate BETWEEN ...) without a full table scan.
  @@unique([userId, entryDate])
  @@map("wellness_entries")
}
